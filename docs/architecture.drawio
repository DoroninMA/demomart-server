<mxfile host="drawio">
  <diagram id="flow" name="Sale flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="720" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="client" value="&lt;b&gt;demomart-client&lt;/b&gt;&lt;br&gt;Android customer app&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TOTP card token · QR · NFC HCE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E5B47;fontColor=#ffffff;strokeColor=none;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="register" value="&lt;b&gt;demomart-register&lt;/b&gt;&lt;br&gt;Android cash register&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;NFC reader · CameraX QR · Smart Tap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E5B47;fontColor=#ffffff;strokeColor=none;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="server" value="&lt;b&gt;demomart-server&lt;/b&gt;&lt;br&gt;FastAPI&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/v1/me · /v1/pos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1EC;strokeColor=#1E5B47;strokeWidth=2;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="db" value="SQLite&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;members · sales · ledger&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFF4E0;strokeColor=#B07A2A;" vertex="1" parent="1"><mxGeometry x="610" y="540" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="auth" value="Firebase Auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B07A2A;" vertex="1" parent="1"><mxGeometry x="960" y="210" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="fcm" value="Firebase Cloud Messaging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B07A2A;" vertex="1" parent="1"><mxGeometry x="960" y="350" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="wallet" value="Google Wallet API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#B07A2A;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="e1" value="① card token DM1:&amp;lt;card&amp;gt;:&amp;lt;TOTP&amp;gt;&lt;br&gt;over NFC (APDU) or QR, works offline" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#1E5B47;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="register"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="② POST /v1/pos/identify&lt;br&gt;③ POST /v1/pos/quote&lt;br&gt;④ POST /v1/pos/commit · /refund" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#1E5B47;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1" source="register" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="GET /v1/me · /history&lt;br&gt;PUT /fcm-token · GET /wallet" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=none;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.35;" edge="1" parent="1" source="client" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="⑤ push: balance changed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#B07A2A;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="fcm" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="375"/><mxPoint x="1190" y="680"/><mxPoint x="95" y="680"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="send" style="html=1;endArrow=block;strokeColor=#B07A2A;fontSize=11;" edge="1" parent="1" source="server" target="fcm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="verify ID token" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B07A2A;fontSize=11;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="server" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="pass objects, save JWT" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#B07A2A;fontSize=11;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="server" target="wallet"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="html=1;endArrow=block;startArrow=block;strokeColor=#666666;" edge="1" parent="1" source="server" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="sign in" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#999999;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="client" target="auth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="40"/><mxPoint x="1050" y="40"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
